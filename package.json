{
  "name": "kan-mcp-full",
  "version": "0.3.0",
  "description": "MCP server for Kan.bn API - exposes 54 tools for workspace, member, board, list, card, label, checklist, comment, and attachment management",
  "author": "Lucian Silva",
  "license": "MIT",
  "main": "src/index.ts",
  "bin": {
    "kan-mcp-full": "src/index.ts"
  },
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    ".env.example"
  ],
  "keywords": [
    "api",
    "attachments",
    "kan",
    "kanban",
    "mcp",
    "model-context-protocol",
    "productivity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciancsilva/kan-mcp.git"
  },
  "homepage": "https://github.com/luciancsilva/kan-mcp#readme",
  "bugs": {
    "url": "https://github.com/luciancsilva/kan-mcp/issues"
  },
  "scripts": {
    "build": "bun build src/index.ts --compile --outfile kan-mcp-full",
    "test": "bun test",
    "test:integration": "INTEGRATION_TEST=true bun test tests/integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
