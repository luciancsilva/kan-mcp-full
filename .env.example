# Kan MCP Configuration
KAN_API_KEY=your_api_key_here
KAN_API_BASE_URL=https://kan.bn/api/v1

# Integration Testing (run with: INTEGRATION_TEST=true bun test tests/integration)
# Note: Check your agent/IDE for how to set environment variables before running tests

# Attachments
# Directory attachment.add may read local files from (filePath is disabled when unset)
# KAN_MCP_UPLOAD_ROOT=/home/you/kan-uploads
# Allow url sources that resolve to private/internal addresses (default: blocked)
# KAN_MCP_ALLOW_PRIVATE_URLS=false
# Directory attachment.download saves files to (tool is disabled when unset)
# KAN_MCP_DOWNLOAD_DIR=/home/you/kan-downloads

# --- Docker / HTTP mode (docker-compose.yml) ---
# Token that clients must send as "Authorization: Bearer <token>" (at least 16 characters).
# Generate one with: openssl rand -hex 32
# MCP_AUTH_TOKEN=
# MCP_TRANSPORT=stdio            # stdio (default outside Docker) or http (default in the image)
# MCP_HOST=127.0.0.1             # the image sets 0.0.0.0
# MCP_PORT=3333
# MCP_PUBLISH_PORT=3333          # host port published by docker-compose.yml (loopback only)
# KAN_MCP_UPLOAD_DIR=./uploads   # host folder mounted at /data/uploads (read only)
# KAN_MCP_DOWNLOAD_DIR=./downloads
# MCP_UID=1000
# MCP_GID=1000
